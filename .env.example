# Optional Facebook proxy. Keep the real value in Render Environment Variables.
FACEBOOK_PROXY_URL=

# URL of the bgutil PO-token provider. For a separate Render service, use its
# private URL, not 127.0.0.1. Example: http://bgutil-provider:4416
YTDLP_POT_PROVIDER_URL=

# Optional server-side YouTube cookies file. On Render, upload it as a Secret File
# named youtube_cookies.txt; then set this value to /etc/secrets/youtube_cookies.txt.
# Never expose or commit this file.
YOUTUBE_COOKIES_FILE=

# Optional tuning
MAX_CONCURRENT_DOWNLOADS=2
THROTTLE_SECONDS=5
INFO_THROTTLE_SECONDS=1
CLEANUP_INTERVAL_SECONDS=300
MAX_FILESIZE_BYTES=2147483648
CORS_ORIGINS=
