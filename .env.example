# ---------------------------------------------------------------------------
# YOUTUBE EXTRACTION
# ---------------------------------------------------------------------------

# Optional Facebook proxy.
FACEBOOK_PROXY_URL=

# URL of the bgutil PO-token provider. In the Docker image this is already set
# to http://127.0.0.1:4416 and the provider is started by start.sh. For a
# separate Render service, use its private URL, not 127.0.0.1.
YTDLP_POT_PROVIDER_URL=

# Optional server-side YouTube cookies file. On Render, upload it as a Secret
# File named youtube_cookies.txt; then set this to
# /etc/secrets/youtube_cookies.txt. Never expose or commit this file.
# It must be Netscape-format cookies.txt, not a browser JSON export.
YOUTUBE_COOKIES_FILE=

# Optional residential proxy for YouTube requests only. Leave empty to route
# YouTube traffic directly.
YOUTUBE_PROXY_URL=

# Optional YouTube player-client chain (comma separated). "yt-dlp defaults" is
# always tried as well. Example: YOUTUBE_CLIENTS=mweb,tv
# Leave unset to use the built-in chain.
YOUTUBE_CLIENTS=
# Optionally pin one client first without dropping the rest.
YOUTUBE_PRIMARY_CLIENT=

# ---------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Leave empty to use a local SQLite file
# (development and tests only). postgres:// is accepted and rewritten.
DATABASE_URL=

# Overrides the SQLite path when DATABASE_URL is empty.
SQLITE_DB_PATH=

# ---------------------------------------------------------------------------
# ACCESS CONTROL
# ---------------------------------------------------------------------------

# Number of trusted reverse proxies in front of the app, used to read the
# client IP from X-Forwarded-For. 0 (the default) ignores the header entirely,
# because it is client-controlled and would otherwise let any caller mint
# unlimited rate-limit buckets. Only raise this if your proxy *overwrites*
# (not appends to) the header.
TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# TUNING
# ---------------------------------------------------------------------------

MAX_CONCURRENT_DOWNLOADS=2
THROTTLE_SECONDS=5
INFO_THROTTLE_SECONDS=1
CLEANUP_INTERVAL_SECONDS=300
MAX_FILESIZE_BYTES=2147483648

# Comma-separated explicit origins for cross-origin browser access. Leave
# empty for same-origin only (the normal deployment).
CORS_ORIGINS=

# Public base URL of the app, surfaced by /api/config.
APP_BASE_URL=

# Node/deno/bun used for YouTube's JS challenges. Auto-detected when unset.
YTDLP_JS_RUNTIME=
YTDLP_VERBOSE=false
YTDLP_USER_AGENT=
