# Optional proxy used by yt-dlp. Leave blank if not needed.
DOWNLOADER_PROXY_URL=

# Optional YouTube PO-token provider. Leave blank if not deployed.
YOUTUBE_POT_PROVIDER_URL=

# Comma-separated browser origins. Leave blank when frontend is served by this same app.
ALLOWED_ORIGINS=

# Limits / housekeeping.
MAX_CONCURRENT_DOWNLOADS=2
THROTTLE_SECONDS=5
FILE_TTL_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=300
